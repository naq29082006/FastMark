# =============================================================================
# FastMark — MỘT file .env dùng chung cho toàn dự án
# Vị trí: FastMark/.env  (cùng cấp với package.json / backend / web / src)
#
# Dùng cho: Expo app + Backend API + Web admin
# KHÔNG tạo .env trong backend/ hoặc web/ — sẽ bị bỏ qua / gây lệch cấu hình
#
# Cách dùng:
#   1. Copy file này thành .env ở thư mục gốc:  copy .env.example .env
#   2. Điền giá trị thật
#   3. Restart: expo / backend (npm run dev) / web admin (npm run admin)
# =============================================================================

# --- Backend server ---
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fastmark?retryWrites=true&w=majority

# --- API URL ---
# Expo: thiết bị thật dùng http://<IP-máy-tính>:5000 (ipconfig → IPv4)
# Emulator Android: app tự dùng http://10.0.2.2:5000
EXPO_PUBLIC_NODE_API_URL=http://192.168.88.101:5000
# Web admin (trình duyệt trên cùng máy chạy backend)
VITE_API_URL=http://localhost:5000

# --- Firebase client (Expo + Web đọc EXPO_PUBLIC_*; Web cũng nhận VITE_* nếu có) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=fastmark-e881d.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=fastmark-e881d
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=3127291193
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=fastmark-e881d.firebasestorage.app

# --- Google OAuth (Expo) — giữ login Google ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=3127291193-vapc6989v56ove18gbib336mpf8aruk4.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=3127291193-94001sfai3r77epe21kd2ngu5qmrrul2.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Supabase client (Expo upload ảnh) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Firebase Admin SDK (Backend) ---
FIREBASE_PROJECT_ID=fastmark-e881d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY=

# --- Supabase server (Backend upload) ---
# Key mới (2025+): sb_publishable_... và sb_secret_...
# Hoặc JWT legacy: eyJ... (anon / service_role)
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- PayOS (nạp tiền Ví FastMark) ---
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=fastmark://wallet/topup-result?status=success
PAYOS_CANCEL_URL=fastmark://wallet/topup-result?status=cancel

# --- SMTP (Backend gửi email xác minh) ---
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# --- Pusher (gửi mã OTP xác minh SĐT seller) ---
PUSHER_APP_ID=2173453
PUSHER_KEY=0efcae9d8c4fdf89509e
PUSHER_SECRET=dba859a493e3b79c60c3
PUSHER_CLUSTER=ap1
PUSHER_ENCRYPTED=true
PUSHER_PHONE_CHANNEL=dashboard-channel
PUSHER_PHONE_EVENT=realtime-update
