@startuml UC00_Tong_quan
!theme plain
title Sơ đồ Use Case Tổng quát – FASTMARK
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #DAE8FC
  BorderColor #6C8EBF
  FontSize 12
}
skinparam actor {
  BackgroundColor #FFF2CC
  BorderColor #D6B656
  FontSize 13
}
skinparam rectangle {
  BorderColor #333333
  FontStyle bold
  FontSize 15
}

actor "Buyer\n(Người mua)" as buyer
actor "Seller\n(Người bán)" as seller
actor "Admin" as admin

seller -|> buyer

rectangle "FASTMARK" #FAFAFA {

  together {
    usecase "Quản lý tài khoản" as UC01
    usecase "Xác minh người bán" as UC02
    usecase "Khám phá SP & gian hàng" as UC03
    usecase "Theo dõi & yêu thích" as UC04
  }

  together {
    usecase "Quản lý gian hàng" as UC05
    usecase "Quản lý sản phẩm" as UC06
    usecase "Giữ hàng" as UC07
    usecase "Tranh chấp & báo cáo" as UC08
  }

  together {
    usecase "Đánh giá" as UC09
    usecase "Ví điện tử" as UC10
    usecase "Gói dịch vụ & quảng cáo" as UC11
    usecase "Thông báo" as UC12
  }

  together {
    usecase "Quản trị người dùng" as UC13
    usecase "Quản trị hệ thống" as UC14
  }
}

buyer --> UC01
buyer --> UC03
buyer --> UC04
buyer --> UC07
buyer --> UC08
buyer --> UC09
buyer --> UC10
buyer --> UC12
buyer --> UC02

seller --> UC05
seller --> UC06
seller --> UC07
seller --> UC08
seller --> UC09
seller --> UC11
seller --> UC12

admin --> UC02
admin --> UC08
admin --> UC10
admin --> UC11
admin --> UC12
admin --> UC13
admin --> UC14

note bottom of UC01
  Chi tiết include/extend
  xem 14 sơ đồ con (UC01–UC14)
end note

@enduml


@startuml UC01_Quan_ly_tai_khoan
