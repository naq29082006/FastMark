// FastMark — DBML từ MongoDB models (backend/models)
// Dán vào: https://dbdiagram.io/d
// ObjectId → varchar. Number enum → int + note. Boolean → boolean. String[] → json.

// ========== AUTH / USER ==========

Table users {
  _id varchar [pk, note: 'ObjectId']
  FirebaseUID varchar [unique, not null, note: 'UID Firebase Auth']
  UserName varchar [unique, not null, note: 'Tên đăng nhập 3-20']
  FullName varchar [not null, note: 'Họ tên hiển thị 2-50']
  Email varchar [unique, note: 'sparse unique']
  Phone varchar [unique, note: 'SĐT 10 số, sparse unique']
  AuthProvider varchar [not null, note: 'email | google']
  Avatar varchar [default: '', note: 'URL ảnh đại diện']
  Role int [default: 1, note: '1=buyer, 2=seller, 3=admin']
  Status int [default: 1, note: '0=khóa, 1=hoạt động']
  lockedAt timestamp [note: 'Mốc lượt khóa hiện tại']
  SoTheoDoi int [default: 0, note: 'Số shop đang follow']
  HoatDongCuoi timestamp [note: 'Lần hoạt động gần nhất']
  VerifyAccount boolean [default: false, note: 'Đã OTP email']
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'Tài khoản người dùng — collection: users'
}

Table pushdevicetokens {
  _id varchar [pk]
  userId varchar [not null, note: '→ users']
  token varchar [unique, not null, note: 'FCM/APNs token']
  platform varchar [default: 'unknown', note: 'android | ios | web | unknown']
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'Token push native gắn thiết bị'
}

// ========== WALLET / FINANCE ==========

Table wallets {
  _id varchar [pk]
  userId varchar [unique, not null, note: '1-1 với User']
  balance float [default: 0, note: 'Số dư VND ≥0']
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'Ví user — quan hệ 1-1 với users'
}

Table systemwallets {
  _id varchar [pk]
  balance float [default: 0, note: 'Tổng cọc escrow đang giữ']
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'Ví hệ thống escrow — singleton (1 bản ghi)'
}

Table wallettransactions {
  _id varchar [pk]
  userId varchar [not null, note: 'Chủ giao dịch → users']
  type int [not null, note: '1=nạp, 2=TT, 3=hoàn, 4=rút, 5=giữ cọc, 6=hoàn cọc, 7=giải phóng cọc']
  amount float [not null, note: 'Số tiền ≥1 VND']
  status int [default: 0, note: '0=chờ, 1=OK, 2=fail, 3=hủy']
  orderCode int [unique, not null, note: 'Mã đối soát nội bộ / PayOS']
  paymentLinkId varchar [default: '']
  checkoutUrl varchar [default: '']
  description varchar [default: '']
  balanceBefore float [note: 'Số dư trước GD']
  balanceAfter float [note: 'Số dư sau GD']
  reservationId varchar [note: 'Đơn giữ hàng (cọc) — denormalize']
  referenceId varchar [note: 'ID tham chiếu chung']
  referenceType varchar [default: '', note: 'Reservation|Report|WithdrawRequest|Topup']
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'Lịch sử giao dịch ví'
}

Table banks {
  _id varchar [pk]
  name varchar [not null]
  code varchar [unique, not null, note: 'Mã NH UPPER']
  isActive int [default: 1, note: '1=đang dùng, 0=xóa mềm']
  CreatedAt timestamp
  UpdatedAt timestamp
}

Table withdrawrequests {
  _id varchar [pk]
  userId varchar [not null]
  bankId varchar [not null]
  bankName varchar [not null, note: 'Snapshot tên NH']
  bankCode varchar [default: '']
  accountNumber varchar [not null]
  accountName varchar [not null]
  amount float [not null, note: '≥1 VND']
  status int [default: 0, note: '0=chờ duyệt, 1=đã duyệt, 2=từ chối']
  gdViId varchar [note: 'GD trừ ví khi rút → wallettransactions']
  gdHoanId varchar [note: 'GD hoàn khi từ chối → wallettransactions']
  adminNote varchar [default: '']
  xuLyBoi varchar [note: 'Admin xử lý → users']
  tgXuLy timestamp
  CreatedAt timestamp
  UpdatedAt timestamp
}

// ========== SHOP / SELLER ==========

Table shopcategories {
  _id varchar [pk]
  name varchar [unique, not null]
  description varchar
  IsDeleted int [default: 1, note: '1=đang dùng, 0=xóa mềm']
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'collection: shopcategories'
}

Table shopprofiles {
  _id varchar [pk]
  userId varchar [note: 'Chủ shop → users']
  shopName varchar [default: '']
  shopUsername varchar [default: '', note: 'Handle @username, lowercase']
  avatar varchar [default: '', note: 'Ảnh gian hàng']
  description varchar [default: '']
  addressHeThong varchar [default: '', note: 'Địa chỉ geocode']
  latlong_lat float [note: 'embedded latlong.lat']
  latlong_long float [note: 'embedded latlong.long']
  categoryId varchar [note: '→ shopcategories']
  openTime varchar [default: '', note: 'HH:mm']
  closeTime varchar [default: '', note: 'HH:mm']
  isOpen int [default: 1, note: '0=đóng, 1=mở']
  status int [default: 1, note: '0=khóa, 1=hoạt động']
  lockedAt timestamp [note: 'Mốc lượt khóa gian hàng']
  isActive int [default: 0, note: 'Cache gói bán: 1=còn hạn, 0=không']
  soNguoiTheo int [default: 0, note: 'Số follower']
  diemTB float [default: 0, note: 'Điểm TB đánh giá']
  tongDG int [default: 0, note: 'Tổng số đánh giá']
  tongSP int [default: 0, note: 'Tổng sản phẩm']
  soldCount int [default: 0]
  cocTien float [default: 0, note: '% cọc 0-100']
  CreatedAt timestamp
  UpdatedAt timestamp
}

Table sellerverifications {
  _id varchar [pk]
  userId varchar [not null]
  anhCccdTruoc varchar [default: '']
  anhCccdSau varchar [default: '']
  selfieImage varchar [default: '']
  fullName varchar [default: '', note: 'Họ tên trên CCCD']
  cccdNumber varchar [default: '', note: '9 hoặc 12 chữ số']
  anhKD varchar [default: '', note: 'Giấy phép KD / ATTP']
  categoryId varchar [note: '→ shopcategories']
  shopName varchar [default: '']
  shopUsername varchar [default: '']
  addressHeThong varchar [default: '']
  latlong_lat float
  latlong_long float
  status int [default: 0, note: '0=chờ duyệt, 1=đã duyệt, 2=từ chối']
  LyDoTuChoi varchar [default: '']
  approvedBy varchar [note: 'Admin duyệt → users']
  CreatedAt timestamp
  UpdatedAt timestamp
}

Table sellerplans {
  _id varchar [pk]
  name varchar [not null]
  description varchar [default: '']
  durationDays int [not null, note: 'Số ngày ≥1']
  price float [not null]
  isActive int [default: 1, note: '1=đang bán, 0=xóa mềm']
  CreatedAt timestamp
  UpdatedAt timestamp
}

Table sellersubscriptions {
  _id varchar [pk]
  sellerId varchar [not null, note: '→ users']
  shopId varchar [not null, note: '→ shopprofiles']
  planId varchar [not null, note: '→ sellerplans']
  planName varchar [default: '', note: 'Snapshot tên gói']
  amount float [not null]
  ngayMua timestamp
  startDate timestamp [not null]
  endDate timestamp [not null]
  status int [default: 0, note: '0=chờ TT, 1=active, 2=hết hạn, 3=hủy']
  gdViId varchar [note: 'GD trừ ví → wallettransactions']
  CreatedAt timestamp
  UpdatedAt timestamp
}

Table bannerplans {
  _id varchar [pk]
  name varchar [not null]
  description varchar [default: '']
  durationDays int [not null]
  price float [not null]
  isActive int [default: 1, note: '1=đang bán, 0=xóa mềm']
  CreatedAt timestamp
  UpdatedAt timestamp
}

Table sellerbannerplans {
  _id varchar [pk]
  sellerId varchar [not null]
  shopId varchar [not null]
  planId varchar [not null, note: '→ bannerplans']
  planName varchar [default: '']
  durationDays int [default: 7, note: 'Snapshot số ngày']
  amount float [not null]
  ngayMua timestamp
  startDate timestamp [note: 'null đến khi admin duyệt']
  endDate timestamp
  status int [default: 0, note: '0=purchased, 1=active, 2=cancelled, 3=rejected, 4=pending_review']
  approvedAt timestamp
  lyDoVP varchar [default: '', note: 'Lý do vi phạm / từ chối']
  image varchar [default: '']
  targetType int [default: 2, note: '1=SP, 2=shop']
  targetId varchar [default: '']
  clickCount int [default: 0]
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'Banner Home = status ACTIVE + còn hạn'
}

// ========== PRODUCT ==========

Table categories {
  _id varchar [pk]
  name varchar [unique, not null]
  description varchar
  IsDeleted int [default: 1, note: '1=dùng, 0=xóa mềm']
  disputeDays int [default: 7, note: 'Số ngày khiếu nại sau nhận hàng 1-30']
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'ProductCategory — collection: categories'
}

Table products {
  _id varchar [pk]
  ShopId varchar [not null, note: '→ shopprofiles']
  CategoryId varchar [not null, note: '→ categories']
  ProductName varchar [not null]
  Description varchar [default: '']
  DonVi varchar [default: '']
  images json [note: 'string[] URL, max 5 — phần tử đầu = cover']
  ViewCount int [default: 0]
  LikeCount int [default: 0]
  SoldCount int [default: 0]
  Status int [default: 1, note: '0=ẩn, 1=đang bán']
  MinPrice float [default: 0]
  MaxPrice float [default: 0]
  IsPromotion boolean [default: false]
  PtGiam float [default: 0, note: '% giảm 0-100']
  NgayKmBD timestamp
  NgayKmKT timestamp
  pinProduct int [default: 0, note: '0=không ghim, 1|2=vị trí ghim/shop']
  IsDeleted int [default: 1, note: '1=còn, 0=đã gỡ']
  RemovedBy varchar [default: '', note: 'admin | seller']
  LyDoGo varchar [default: '']
  RemovedAt timestamp
  CreatedAt timestamp
  UpdatedAt timestamp
}

Table productvariants {
  _id varchar [pk]
  ProductId varchar [not null]
  VariantName varchar [not null]
  Price float [not null]
  Quantity int [not null, default: 0]
  SoldCount int [default: 0]
  ImageUrl varchar [default: '']
  Status int [default: 1, note: '0=ẩn, 1=bán']
  CreatedAt timestamp
  UpdatedAt timestamp
}

Table favoriteproducts {
  _id varchar [pk]
  userId varchar [not null]
  productId varchar [not null]
  CreatedAt timestamp

  Note: 'UK compound (userId, productId)'
}

// ========== RESERVATION / ORDER ==========

Table reservations {
  _id varchar [pk]
  userId varchar [note: 'Buyer → users']
  shopId varchar [note: '→ shopprofiles']
  productId varchar [note: '→ products']
  variantId varchar [note: '→ productvariants, null nếu không có BT']
  quantity int
  reservedPrice float [note: 'Giá ĐV lúc đặt VND']
  depositAmount float [default: 0, note: 'Số tiền cọc đã trừ ví']
  depositPercent float [default: 0, note: '% cọc snapshot 0-100']
  pickupCode varchar [default: '', note: 'Mã 6 số QR']
  pickupTime timestamp
  note varchar [default: '', note: 'Ghi chú buyer khi đặt']
  status int [default: 0, note: '0=Pending, 1=WaitingPickup, 2=PickupConfirmed, 3=Disputed, 4=Completed, 5=Cancelled']
  hasReview boolean [default: false]
  tgShopXN timestamp [note: 'Shop đồng ý giữ hàng']
  tgNhanHang timestamp [note: 'Xác nhận đã nhận (QR)']
  cancelledAt timestamp
  cancelNote varchar [default: '', note: 'Ghi chú hủy do seller/admin']
  cancelType varchar [default: '', note: 'Mã RESERVATION_CANCEL_REASON']
  anhHuyShop json [note: 'string[] URL minh chứng shop hủy']
  tgGiaiCoc timestamp [note: 'Thời điểm giải ngân cọc thực tế']
  cocChuyenDen int [default: 0, note: '0=escrow, 1=hoàn buyer, 2=giải ngân seller']
  soNgayKN int [note: 'Số ngày khiếu nại snapshot 1-30']
  hanGiaiCoc timestamp [note: 'Hạn giải cọc / hết cửa sổ khiếu nại']
  inventoryHeld boolean [default: false]
  createdAt timestamp
  updatedAt timestamp

  Note: 'Đơn giữ hàng + cọc escrow — tranh chấp → reservationdisputes'
}

Table reservationdisputes {
  _id varchar [pk]
  reservationId varchar [unique, not null, note: '1-1 → reservations']
  buyerUserId varchar [note: '→ users']
  maLyDoBuyer int [note: 'Mã lý do buyer']
  buyerContent varchar [default: '']
  buyerImages json [note: 'string[] max 5']
  tgKnBuyer timestamp
  sellerShopId varchar [note: '→ shopprofiles']
  maLyDoShop int [note: 'Lý do seller pickup']
  sellerContent varchar [default: '']
  sellerImages json [note: 'string[] max 5']
  tgKnShop timestamp
  disputeKind varchar [default: 'pickup', note: 'pickup | post_delivery']
  status int [default: 0, note: 'DISPUTE_STATUS enum']
  adminNote varchar [default: '']
  resolvedBy varchar [note: '→ users']
  resolvedAt timestamp
  auditLogs json [note: 'embedded[]: adminId, action, decision, note, createdAt']
  createdAt timestamp
  updatedAt timestamp
}

Table reservationadjustments {
  _id varchar [pk]
  reservationId varchar [not null]
  shopId varchar [not null]
  buyerId varchar [not null]
  productId varchar [not null]
  oldQuantity int [not null]
  newQuantity int [not null]
  giaCu float [not null]
  giaMoi float [not null]
  cocCu float [not null]
  cocMoi float [not null]
  createdAt timestamp

  Note: 'Audit điều chỉnh đơn tại quầy'
}

// ========== REVIEW ==========

Table reviews {
  _id varchar [pk]
  userId varchar [not null]
  shopId varchar [not null]
  productId varchar [not null]
  reservationId varchar [not null, note: 'Partial UK khi isDeleted=1']
  rating int [not null, note: '1-5']
  comment varchar [default: '']
  images json [note: 'string[] max 5']
  isDeleted int [default: 1, note: '1=còn, 0=đã gỡ']
  removedBy varchar [default: '', note: 'buyer | admin']
  lyDoGo varchar [default: '']
  removedAt timestamp
  CreatedAt timestamp
  UpdatedAt timestamp
}

// ========== SOCIAL / INBOX ==========

Table follows {
  _id varchar [pk]
  followerId varchar [not null, note: 'User follow → users']
  shopId varchar [not null, note: 'Shop được follow → shopprofiles']
  CreatedAt timestamp

  Note: 'UK compound (followerId, shopId)'
}

Table notifications {
  _id varchar [pk]
  userId varchar [note: '→ users']
  title varchar
  content varchar
  audience varchar [default: 'system', note: 'buyer | seller | system']
  isRead int [default: 0, note: '0=chưa, 1=đã đọc']
  index int [default: 2, note: '1=đơn hàng, 2=hệ thống — tab lọc']
  tbAdmin boolean [default: false, note: 'Admin broadcast']
  CreatedAt timestamp
  UpdatedAt timestamp
}

// ========== REPORT ==========

Table reports {
  _id varchar [pk]
  userId varchar [note: 'Người gửi → users']
  productId varchar [note: 'reportType=3']
  shopId varchar [note: 'reportType=2 hoặc khiếu nại khóa shop']
  reviewId varchar [note: 'reportType=1 → reviews']
  reportType int [not null, note: '1=review, 2=shop, 3=SP, 4=hệ thống, 5=khác, 6=KN khóa TK, 7=KN khóa shop']
  title varchar
  content varchar
  images json [note: 'string[] max 5 minh chứng']
  status int [default: 0, note: '0=chờ, 1=đã xử lý, 2=bác bỏ']
  phienKhoa timestamp [note: 'Mốc lockedAt khi tạo KN khóa']
  xuLyBoi varchar [note: '→ users']
  tgXuLy timestamp
  qdAdmin varchar [default: '']
  adminNote varchar [default: '']
  CreatedAt timestamp
  UpdatedAt timestamp

  Note: 'Tranh chấp giữ hàng dùng reservationdisputes, không tạo Report'
}

// ========== REFS ==========

Ref: pushdevicetokens.userId > users._id

Ref: wallets.userId - users._id

Ref: wallettransactions.userId > users._id
Ref: wallettransactions.reservationId > reservations._id

Ref: withdrawrequests.userId > users._id
Ref: withdrawrequests.bankId > banks._id
Ref: withdrawrequests.gdViId > wallettransactions._id
Ref: withdrawrequests.gdHoanId > wallettransactions._id
Ref: withdrawrequests.xuLyBoi > users._id

Ref: shopprofiles.userId > users._id
Ref: shopprofiles.categoryId > shopcategories._id

Ref: sellerverifications.userId > users._id
Ref: sellerverifications.categoryId > shopcategories._id
Ref: sellerverifications.approvedBy > users._id

Ref: sellersubscriptions.sellerId > users._id
Ref: sellersubscriptions.shopId > shopprofiles._id
Ref: sellersubscriptions.planId > sellerplans._id
Ref: sellersubscriptions.gdViId > wallettransactions._id

Ref: sellerbannerplans.sellerId > users._id
Ref: sellerbannerplans.shopId > shopprofiles._id
Ref: sellerbannerplans.planId > bannerplans._id

Ref: products.ShopId > shopprofiles._id
Ref: products.CategoryId > categories._id
Ref: productvariants.ProductId > products._id
Ref: favoriteproducts.userId > users._id
Ref: favoriteproducts.productId > products._id

Ref: reservations.userId > users._id
Ref: reservations.shopId > shopprofiles._id
Ref: reservations.productId > products._id
Ref: reservations.variantId > productvariants._id

Ref: reservationdisputes.reservationId - reservations._id
Ref: reservationdisputes.buyerUserId > users._id
Ref: reservationdisputes.sellerShopId > shopprofiles._id
Ref: reservationdisputes.resolvedBy > users._id

Ref: reservationadjustments.reservationId > reservations._id
Ref: reservationadjustments.shopId > shopprofiles._id
Ref: reservationadjustments.buyerId > users._id
Ref: reservationadjustments.productId > products._id

Ref: reviews.userId > users._id
Ref: reviews.shopId > shopprofiles._id
Ref: reviews.productId > products._id
Ref: reviews.reservationId > reservations._id

Ref: follows.followerId > users._id
Ref: follows.shopId > shopprofiles._id

Ref: notifications.userId > users._id

Ref: reports.userId > users._id
Ref: reports.productId > products._id
Ref: reports.shopId > shopprofiles._id
Ref: reports.reviewId > reviews._id
Ref: reports.xuLyBoi > users._id
